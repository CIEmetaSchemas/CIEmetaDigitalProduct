		"metadataRevision": {
			"type": "integer",
			"minimum": 1,
			"$comment": "CIE: revision number of THIS JSON metadata file. Starts at 1 and increments only when the metadata content changes; it is NOT bumped by envelope-level changes such as the DOI landing-page URL or the CIE division. Distinct from the DataCite 'version' field, which versions the described resource. Optional for backward compatibility."
